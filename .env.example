ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Anthropic doesn't serve embeddings directly; Voyage AI is their recommended
# embedding partner for pgvector RAG. voyage-3 embeds at 1024 dims (matches
# session_content.embedding in db/schema.sql) -- if you switch models, update
# the column dimension too.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

DATABASE_URL=postgresql://user:password@localhost:5432/faqbot

# Default human that action_request routes to when the LLM doesn't name someone else.
ACTION_REQUEST_HUMAN=Arvind

APP_NAME=Gen Academy FAQ Bot
KNOWLEDGE_BASE_PATH=knowledge_base/gen_academy_faq.md

# Required. The bot passes the full knowledge base to Gemini for every content
# question and has no local answer-generation fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Discord escalation. Career, action-required, and unanswered questions are posted here when configured.
DISCORD_WEBHOOK_URL=

# Email escalation. Career, action-required, and unanswered questions are emailed here when configured.
ESCALATION_EMAIL_TO=
EMAIL_FROM=faq-bot@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
